# ==============================================================================
# StudyNotes AutoPoster - Environment Variables
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Google Gemini API
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Official Meta / Instagram Graph API Configuration
# Note: Keep disabled until you have configured Facebook Developer App
INSTAGRAM_PUBLISH_ENABLED=false
DRY_RUN=true

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
META_APP_ID=
META_APP_SECRET=

# Public base URL required by Instagram Graph API to fetch images for publishing
# In production, set to your publicly accessible domain or ngrok tunnel URL
PUBLIC_BASE_URL=http://localhost:8000

# Storage & Database Paths (relative to project root or absolute)
DATABASE_PATH=data/studynotes.db
TOPICS_FILE_PATH=data/topics.json
OUTPUT_DIR=generated
LOG_FILE_PATH=logs/app.log
